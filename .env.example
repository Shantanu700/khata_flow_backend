# Copy to .env (`cp .env.example .env`) and fill in. Never commit .env.

DEBUG=1
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Comma-separated; not needed with DEBUG=1 on localhost.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Leave these unset for Docker: the defaults point at the compose db and redis services.
# Set them only when running Django on the host instead of in Docker.
# DATABASE_URL=postgres://khaataflow:khaataflow@localhost:5435/khaataflow
# REDIS_URL=redis://localhost:6379/0

DEFAULT_LANGUAGE=hi-IN

# gnani (real APIs) or fake (no network; tests always use fake).
STT_PROVIDER=gnani
TTS_PROVIDER=gnani
# From https://app.gnani.ai (API keys). Sent as the X-API-Key-ID header.
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_FORMAT=transcribe
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Poorvi
GNANI_TTS_LANGUAGE=hi-IN

# Intent extraction LLM (any OpenAI-compatible endpoint; Groq by default).
LLM_PROVIDER=groq
# From https://console.groq.com/keys
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# Tuning knobs (defaults shown).
# MAX_AUDIO_SECONDS=20
# LEDGER_AMOUNT_CAP=50000
# RESOLVER_AUTO_SCORE=88
# RESOLVER_MIN_SCORE=70
# RESOLVER_MARGIN=8
