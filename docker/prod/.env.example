# Production settings. Copy to docker/prod/.env on the server and fill in. Never commit .env.

# The API's public hostname: a free DuckDNS name (e.g. khataflow.duckdns.org) or your own domain.
# Caddy gets its HTTPS certificate for this name.
API_HOST=
ALLOWED_HOSTS=${API_HOST}
CSRF_TRUSTED_ORIGINS=https://${API_HOST}
# Where browsers open the live-transcript WebSocket.
VOICE_STREAM_URL=wss://${API_HOST}/api/v1/voice/stream/
# The web app's address (Cloudflare Workers), e.g. https://khataflow.<you>.workers.dev
CORS_ALLOWED_ORIGINS=

DEBUG=0
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Supabase: Project > Connect > Session pooler (IPv4; the direct connection is IPv6-only).
DATABASE_URL=postgresql://postgres.<project ref>:<password>@<pooler host>:5432/postgres?sslmode=require

# Cloudflare R2 (see ../../.env.example).
R2_BUCKET=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

DEFAULT_LANGUAGE=en-IN

STT_PROVIDER=gnani
TTS_PROVIDER=gnani
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_FORMAT=transcribe
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_TTS_LANGUAGE=hi-IN

LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_REASONING_EFFORT=medium
